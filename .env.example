# Server
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/health-portal

# Security
ALLOW_PUBLIC_REGISTRATION=false
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
# CORS_ORIGIN=http://localhost:5173

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@healthportal.com
APP_URL=http://localhost:3000

# ML
PYTHON_BIN=
HOSPITAL_NAME=Care and Cure Hospital
